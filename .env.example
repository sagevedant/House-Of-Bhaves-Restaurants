# Server
PORT=3000

# Database (Turso LibSQL cloud database)
# REQUIRED: Turso credentials. The app will fail to start without these.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token
DATABASE_PATH=./data/hob-restaurant.db

# Meta Tech Provider & Embedded Signup (Agency-Level Credentials)
# META_APP_ID & META_APP_SECRET from Meta App Dashboard (Settings -> Basic).
# META_EMBEDDED_SIGNUP_CONFIG_ID from WhatsApp -> Quickstart / Configuration in App Dashboard.
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_EMBEDDED_SIGNUP_CONFIG_ID=your_embedded_signup_configuration_id
# Agency-level System User Permanent Access Token (used for Graph API queries & subscribing apps)
META_SYSTEM_USER_ACCESS_TOKEN=your_agency_system_user_token

# WhatsApp Cloud API (Legacy Single-Tenant / Fallback Credentials)
WHATSAPP_PHONE_NUMBER_ID=your_fallback_phone_number_id
# Webhook Security
# Set to 'true' to strictly enforce Meta X-Hub-Signature-256 HMAC verification.
# Requires META_APP_SECRET to be configured. Keep false until Meta Business Account setup is complete.
ENFORCE_WEBHOOK_SIGNATURE=false
# REQUIRED: Token configured in Meta Webhook configuration
WEBHOOK_VERIFY_TOKEN=your_webhook_verify_secret

# HTTP Basic Auth Credentials for Admin Routes (/agency, /onboard, /restaurant/*)
# REQUIRED to access admin dashboards, customer ledgers, and CSV exports (fails closed if unset).
ADMIN_BASIC_AUTH_USER=admin
ADMIN_BASIC_AUTH_PASS=change_this_password_in_production

# Gemini AI (for Natural Language Intent & Slot Extraction)
GEMINI_API_KEY=your_gemini_api_key

# Make.com Integration (Outbound webhook trigger)
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/your_webhook_id

# Escalation & Manager Alerts
MANAGER_PHONE=919876543210

# Development Mode
# If true, outbound WhatsApp messages are logged to console instead of dispatched to Meta Graph API
MOCK_WHATSAPP=true
